STORAGE_BACKEND=aws
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1
AWS_DYNAMODB_APP_TABLE=KahrabaIQApp
AWS_DYNAMODB_SUMMARIES_TABLE=SmartEnergySummaries
AWS_IOT_ENDPOINT=your-iot-endpoint-ats.iot.eu-west-1.amazonaws.com
AWS_IOT_WEBSOCKET_EXPIRES_SECONDS=900

COGNITO_USER_POOL_ID=eu-west-1_example
COGNITO_APP_CLIENT_ID=example_client_id
PLATFORM_ADMIN_EMAILS=admin@example.com

INTERNAL_SERVICE_TOKEN=change_me
PI_DASHBOARD_TOKEN=change_me
KIOSK_SESSION_SECRET=change_me_to_a_long_random_secret
PAIRING_TOKEN_TTL_SECONDS=900
KIOSK_SESSION_TTL_SECONDS=600
REMOTE_COMMAND_TTL_SECONDS=60

AI_SERVICE_URL=https://your-ai-service.example.com
DEFAULT_HOME_ID=home_001
MODEL_PATH=devices/models/smart_energy_ai.joblib
GEMINI_API_KEY=change_me

HOME_ASSISTANT_URL=http://127.0.0.1:8123
HOME_ASSISTANT_TOKEN=change_me
HOME_ASSISTANT_TIMEOUT_SECONDS=5
USE_HOME_ASSISTANT_FOR_BREAKERS=true
USE_TUYA_CLOUD_FOR_BREAKERS=false
AC_BREAKER_ENTITY_ID=switch.ac_breaker_switch
SOCKET_BREAKER_ENTITY_ID=switch.socket_breaker_switch

[Unit]
Description=KahrabaIQ Tuya breaker state and metering poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kahrabaiq/pi/agent
EnvironmentFile=/etc/kahrabaiq/pi.env
ExecStart=/opt/kahrabaiq/.venv/bin/python /opt/kahrabaiq/pi/agent/tuya_breaker_poller.py
Restart=always
RestartSec=10
User=pi

[Install]
WantedBy=multi-user.target

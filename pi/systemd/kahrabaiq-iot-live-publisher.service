[Unit]
Description=KahrabaIQ AWS IoT live dashboard publisher
After=network-online.target kahrabaiq-provisioning.service kahrabaiq-sensor-receiver.service
Wants=network-online.target
Requires=kahrabaiq-provisioning.service

[Service]
Type=simple
WorkingDirectory=/opt/kahrabaiq/pi/agent
EnvironmentFile=/etc/kahrabaiq/pi.env
ExecStart=/opt/kahrabaiq/.venv/bin/python /opt/kahrabaiq/pi/agent/aws_iot_live_publisher.py
Restart=always
RestartSec=10
User=pi

[Install]
WantedBy=multi-user.target

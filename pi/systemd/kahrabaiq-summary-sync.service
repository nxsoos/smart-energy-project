[Unit]
Description=KahrabaIQ hourly and daily summary sync
After=network-online.target kahrabaiq-provisioning.service kahrabaiq-sensor-receiver.service
Wants=network-online.target
Requires=kahrabaiq-provisioning.service

[Service]
Type=simple
WorkingDirectory=/opt/kahrabaiq/pi/agent
EnvironmentFile=/etc/kahrabaiq/pi.env
ExecStart=/opt/kahrabaiq/.venv/bin/python /opt/kahrabaiq/pi/agent/summary_sync.py
Restart=always
RestartSec=10
User=pi

[Install]
WantedBy=multi-user.target

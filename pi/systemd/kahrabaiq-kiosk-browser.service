[Unit]
Description=KahrabaIQ Pi touchscreen kiosk browser
After=graphical.target kahrabaiq-provisioning.service kahrabaiq-agent.service
Wants=kahrabaiq-agent.service
Requires=kahrabaiq-provisioning.service

[Service]
Type=simple
EnvironmentFile=/etc/kahrabaiq/pi.env
ExecStartPre=/bin/sh -c 'test -f "${PROVISIONING_MARKER_PATH:-/var/lib/kahrabaiq/provisioned.json}"'
ExecStart=/opt/kahrabaiq/pi/scripts/launch-kiosk.sh
Restart=always
RestartSec=5
User=pi

[Install]
WantedBy=graphical.target

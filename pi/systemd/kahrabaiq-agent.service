[Unit]
Description=KahrabaIQ Pi local agent and kiosk token bridge
After=network-online.target kahrabaiq-provisioning.service
Wants=network-online.target
Requires=kahrabaiq-provisioning.service

[Service]
Type=simple
WorkingDirectory=/opt/kahrabaiq/pi/agent
EnvironmentFile=/etc/kahrabaiq/pi.env
ExecStart=/opt/kahrabaiq/.venv/bin/python /opt/kahrabaiq/pi/agent/pi_agent.py
Restart=always
RestartSec=5
User=pi

[Install]
WantedBy=multi-user.target

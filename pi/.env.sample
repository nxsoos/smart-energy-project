# KahrabaIQ Pi runtime
HOME_ID=
PI_ID=pi_unique_id
PI_DEVICE_TOKEN=change_me
KAHRABAIQ_API_URL=https://YOUR_CLOUD_API_URL

# Local agent and kiosk
PI_AGENT_PORT=5010
PI_AGENT_VERSION=local-agent-1
ENABLE_AWS_IOT_LIVE=true
ENABLE_AWS_SUMMARY_SYNC=true
ENABLE_AWS_REMOTE_COMMANDS=true
PI_HEARTBEAT_INTERVAL_SECONDS=45
PI_LIVE_SYNC_INTERVAL_SECONDS=15
PI_COMMAND_POLL_SECONDS=3
KIOSK_TOKEN_REFRESH_MARGIN_SECONDS=240
KIOSK_DASHBOARD_URL=https://YOUR_CLOUD_API_URL/api/kiosk/dashboard

# ESP32 provisioning and receiver
ESP32_DEVICE_ID=esp32_01
ESP32_DEVICE_KEY=change_me
ESP32_DEVICE_KEY_HASH=
ESP32_SETUP_URL=http://192.168.4.1
ESP32_DISCOVERY_CANDIDATES=http://kahrabaiq-esp32.local,http://192.168.4.1
PI_LOCAL_BASE_URL=http://kahrabaiq-pi.local:5001
PI_SENSOR_BASE_URL=http://kahrabaiq-pi.local:5000

# Local SQLite buffer
LOCAL_STATE_DB_PATH=/var/lib/kahrabaiq/local_state.sqlite3
LOCAL_RAW_HISTORY_ENABLED=true
LOCAL_HISTORY_MAX_RECORDS=5000

# Home Assistant and Matter on the Pi
HOME_ASSISTANT_URL=http://127.0.0.1:8123
HOME_ASSISTANT_TOKEN=change_me_after_creating_a_long_lived_access_token
HOME_ASSISTANT_COMMAND_MODE=queue
HOME_ASSISTANT_TIMEOUT_SECONDS=5
USE_HOME_ASSISTANT_FOR_BREAKERS=true
USE_TUYA_CLOUD_FOR_BREAKERS=false
AC_BREAKER_ENTITY_ID=switch.ac_breaker_switch
SOCKET_BREAKER_ENTITY_ID=switch.socket_breaker_switch
AC_BREAKER_CURRENT_ENTITY_ID=sensor.ac_breaker_current
AC_BREAKER_POWER_ENTITY_ID=sensor.ac_breaker_power
AC_BREAKER_VOLTAGE_ENTITY_ID=sensor.ac_breaker_voltage
AC_BREAKER_ENERGY_ENTITY_ID=sensor.ac_breaker_energy
SOCKET_BREAKER_CURRENT_ENTITY_ID=sensor.socket_breaker_current
SOCKET_BREAKER_POWER_ENTITY_ID=sensor.socket_breaker_power
SOCKET_BREAKER_VOLTAGE_ENTITY_ID=sensor.socket_breaker_voltage
SOCKET_BREAKER_ENERGY_ENTITY_ID=sensor.socket_breaker_energy
MATTER_SOCKET_SWITCH_ENTITY_ID=switch.socket_breaker_switch
MATTER_AC_SWITCH_ENTITY_ID=switch.ac_breaker_switch
LOCAL_HA_STATE_SYNC_INTERVAL_SECONDS=5

# Local command execution for AWS-queued device commands
REMOTE_COMMAND_SOURCE=ec2
REMOTE_COMMAND_POLL_SECONDS=5
REMOTE_COMMAND_QUERY_LIMIT=25
LOCAL_COMMAND_VERIFY_DELAY_SECONDS=1.5
TUYA_ACCESS_ID=your_tuya_cloud_access_id
TUYA_ACCESS_SECRET=your_tuya_cloud_access_secret_do_not_commit_real_value
TUYA_API_ENDPOINT=https://openapi.tuyaeu.com
TUYA_BREAKER_01_DEVICE_ID=your_switch_breaker_device_id
TUYA_BREAKER_02_DEVICE_ID=your_ac_breaker_device_id
TUYA_VERIFY_ATTEMPTS=7
TUYA_BREAKER_POLL_SECONDS=15

# AWS summary sync
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1
AWS_DYNAMODB_SUMMARIES_TABLE=SmartEnergySummaries
SUMMARY_LOOKBACK_HOURS=48
SUMMARY_LOOKBACK_DAYS=7
SUMMARY_SYNC_BATCH_SIZE=25
AWS_SUMMARY_SYNC_INTERVAL_SECONDS=300

# AWS IoT live dashboard publisher
AWS_IOT_ENDPOINT=your-iot-endpoint-ats.iot.eu-west-1.amazonaws.com
AWS_IOT_CLIENT_ID=smart-energy-pi-home_001
AWS_IOT_LIVE_TOPIC=homes/home_001/live/state
AWS_IOT_LIVE_INTERVAL_SECONDS=15
AWS_IOT_RETAIN_LIVE_STATE=false
AWS_IOT_PUBLISH_LOG_EVERY=10
AWS_IOT_CERT_PATH=/etc/kahrabaiq/certs/device.pem.crt
AWS_IOT_KEY_PATH=/etc/kahrabaiq/certs/private.pem.key
AWS_IOT_CA_PATH=/etc/kahrabaiq/certs/AmazonRootCA1.pem

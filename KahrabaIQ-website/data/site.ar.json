  "features": [
    { "title": "تحسين الطاقة", "icon": "bolt", "description": "يوزان الذكاء الاصطناعي الطلب بين الأحمال المتصلة وينظم تشغيل الأجهزة عالية الاستهلاك بدقة. يتم كشف الهدر مبكرا قبل أن يظهر أثره في الفاتورة." },
    { "title": "الوعي بالإشغال", "icon": "eye", "description": "تعتمد طبقة الاستشعار على الحضور الفعلي داخل الغرفة بدلا من الجداول الثابتة. تتكيف الإضاءة والأجهزة فقط عندما تكون المساحة مستخدمة." },
    { "title": "حماية من الحمل الزائد", "icon": "shield", "description": "تراقب حساسات التيار أنماط الحمل غير الطبيعية لحظة بلحظة. يمكن تفعيل المرحلات الوقائية قبل أن يتحول الضغط إلى تلف في المعدات." },
    { "title": "الحريق والطوارئ", "icon": "flame", "description": "تتحد إشارات الدخان والحرارة والخطر داخل طبقة منطق طوارئ واحدة. يعطي النظام الأولوية للتنبيهات الحاسمة والاستجابة الوقائية السريعة." },
    { "title": "محرك القرار الذكي", "icon": "cpu", "description": "تقيم طبقة ذكاء مبنية بلغة بايثون سياق الحساسات وحالة التشغيل المباشرة. تقترح قرارات تحكم آمنة وفعالة باتساق آلي." },
    { "title": "مراقبة فورية", "icon": "activity", "description": "تعرض لوحة التحكم استهلاك الطاقة، حالات الغرف، نشاط المرحلات، وإشارات الخطر فور حدوثها. يرى المشغل البيئة الكهربائية بلا تأخير أو تخمين." },
    { "title": "سلامة تنبؤية", "icon": "radar", "description": "يكشف تحليل الأنماط مؤشرات الخطر المبكرة قبل أن تتحول إلى أعطال. تنتقل السلامة الكهربائية من رد الفعل إلى التحكم الاستباقي." }

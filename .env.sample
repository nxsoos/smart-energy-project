# KahrabaIQ Cloud API
STORAGE_BACKEND=aws
PLATFORM_ADMIN_EMAILS=admin@example.com
AI_SERVICE_URL=https://YOUR_AI_SERVICE_URL
INTERNAL_SERVICE_TOKEN=change_me
PI_DASHBOARD_TOKEN=change_me
HOME_MEMBER_LIMIT=3
PAIRING_TOKEN_TTL_SECONDS=900
HOME_INVITE_TTL_SECONDS=604800
KIOSK_SESSION_TTL_SECONDS=600
KIOSK_COMMAND_TTL_SECONDS=300
KIOSK_SESSION_SECRET=change_me_to_a_long_random_secret

# Home Assistant
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=change_me
HOME_ASSISTANT_COMMAND_MODE=auto
HA_SYNC_INTERVAL_SECONDS=30

# Raspberry Pi Dashboard
CLOUD_BACKEND_ENABLED=true
HOME_ID=
PI_ID=pi_unique_id
PI_DEVICE_TOKEN=change_me
KAHRABAIQ_API_URL=https://YOUR_CLOUD_API_URL
# Deprecated fallback for older Pi scripts. Prefer KAHRABAIQ_API_URL.
SMART_ENERGY_API_URL=https://YOUR_CLOUD_API_URL
PI_AGENT_PORT=5010
PI_AGENT_VERSION=local-agent-1
PI_HEARTBEAT_INTERVAL_SECONDS=45
PI_LIVE_SYNC_INTERVAL_SECONDS=10
PI_COMMAND_POLL_SECONDS=3
KIOSK_TOKEN_REFRESH_MARGIN_SECONDS=240
KIOSK_DASHBOARD_URL=https://YOUR_CLOUD_API_URL/api/kiosk/dashboard
KIOSK_ADMIN_PASSWORD_HASH=sha256_hash_here
KIOSK_ADMIN_PASSWORD=
EMERGENCY_SAFE_DEVICE_IDS=breaker_01,matter_ac_switch
PI_LOCAL_BASE_URL=http://kahrabaiq-pi.local:5001
PI_SENSOR_BASE_URL=http://kahrabaiq-pi.local:5000
ESP32_SETUP_URL=http://192.168.4.1
ESP32_DEVICE_ID=esp32_01
ESP32_DISCOVERY_CANDIDATES=http://kahrabaiq-esp32.local,http://192.168.4.1

# AI Service
GEMINI_API_KEY=change_me
DEFAULT_HOME_ID=home_001

# Tuya Cloud
TUYA_ACCESS_ID=change_me
TUYA_ACCESS_SECRET=change_me
TUYA_API_ENDPOINT=https://openapi.tuyaeu.com
TUYA_BREAKER_01_DEVICE_ID=change_me
TUYA_BREAKER_02_DEVICE_ID=change_me

# ESP32 sensor receiver
ESP32_DEVICE_KEY=change_me
ESP32_DEVICE_KEY_HASH=

# AWS / IoT
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1
AWS_PROFILE=smart-energy-pi-uploader
AWS_DYNAMODB_APP_TABLE=KahrabaIQApp
AWS_DYNAMODB_SUMMARIES_TABLE=SmartEnergySummaries
AWS_IOT_ENDPOINT=your-iot-endpoint-ats.iot.eu-west-1.amazonaws.com
AWS_IOT_POLICY_NAME=SmartEnergyFlutterLiveSubscribePolicy
AWS_IOT_LIVE_TOPIC=homes/home_001/live/state
AWS_IOT_CLIENT_ID=smart-energy-pi-home_001
AWS_IOT_LIVE_INTERVAL_SECONDS=15
AWS_IOT_CERT_PATH=/home/ali/smart-energy-hub/certs/device.pem.crt
AWS_IOT_KEY_PATH=/home/ali/smart-energy-hub/certs/private.pem.key
AWS_IOT_CA_PATH=/home/ali/smart-energy-hub/certs/AmazonRootCA1.pem

# Flutter dart-defines
KAHRABAIQ_API_URL=https://YOUR_CLOUD_API_URL
BACKEND_API_URL=https://YOUR_CLOUD_API_URL
CLOUD_API_URL=
USE_LOCAL_PI_API=false
REMOTE_LIVE_ONLY=false
PI_API_TIMEOUT_SECONDS=6
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_IDENTITY_POOL_ID=
COGNITO_ADMIN_GROUP=SmartEnergyAdmins
COGNITO_MEMBER_GROUP=SmartEnergyMembers

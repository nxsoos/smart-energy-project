# KahrabaIQ Cloud API
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.REGION.firebasedatabase.app
PLATFORM_ADMIN_EMAILS=admin@example.com
AI_SERVICE_URL=https://YOUR_AI_SERVICE_URL
INTERNAL_SERVICE_TOKEN=change_me
PI_DASHBOARD_TOKEN=change_me
HOME_MEMBER_LIMIT=3
PAIRING_TOKEN_TTL_SECONDS=900
HOME_INVITE_TTL_SECONDS=604800

# Home Assistant
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=change_me
HOME_ASSISTANT_COMMAND_MODE=auto
HA_SYNC_INTERVAL_SECONDS=30

# Raspberry Pi Dashboard
SERVICE_ACCOUNT_PATH=serviceAccountKey.json
FIREBASE_ENABLED=false
CLOUD_BACKEND_ENABLED=false
HOME_ID=home_001
PI_ID=pi_unique_id
PI_DEVICE_TOKEN=change_me
KAHRABAIQ_API_URL=https://YOUR_CLOUD_API_URL
# Deprecated fallback for older Pi scripts. Prefer KAHRABAIQ_API_URL.
SMART_ENERGY_API_URL=https://YOUR_CLOUD_API_URL
KIOSK_ADMIN_PASSWORD_HASH=sha256_hash_here
KIOSK_ADMIN_PASSWORD=
EMERGENCY_SAFE_DEVICE_IDS=breaker_01,matter_ac_switch

# AI Service
GEMINI_API_KEY=change_me
DEFAULT_HOME_ID=home_001

# Flutter dart-defines
BACKEND_API_URL=https://YOUR_CLOUD_API_URL
USE_LOCAL_PI_API=false
